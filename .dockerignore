# Generated by Cargo
# will have compiled files and executables
**/target/

# Keep the workspace lockfile in the Docker build context. The workspace
# contains executable crates, so a reproducible build should use Cargo.lock.
**/Cargo.lock
!/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk


#Added by cargo
#
#already existing elements are commented out

#**/*.rs.bk

**/generated
**/output
**/.idea
**/.vscode
pkg
**/notes.txt


# webpage generated
**/docs/**/*

# allow static images
!**/docs/examples/images/**/*.jpg

# discard test examples
examples/test_*.rs

.DS_Store
/data/
/config.toml
/.env
